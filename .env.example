# ── makeupgirls environment ──────────────────────────────────────────────
# Copy to .env.local for local dev, or set these in your host (Vercel etc.).

# PostgreSQL connection string.
#   Local:  postgresql://USER@localhost:5432/makeupgirls
#   Hosted: use the URL from Neon / Supabase / Vercel Postgres (add ?sslmode=require)
DATABASE_URL=postgresql://user@localhost:5432/makeupgirls

# Secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# First admin account — seeded automatically the first time the DB initialises.
ADMIN_EMAIL=admin@makeupgirls.mn
ADMIN_PASSWORD=change-me

# Hostname that serves the admin panel (host-based routing in middleware.ts).
ADMIN_HOST=admin.makeupgirls.mn
